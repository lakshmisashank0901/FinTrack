# FinTrack API configuration. Copy to .env and fill in real values.
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO

# Postgres connection for the least-privilege fintrack_api role (see README).
# Supabase: Project Settings → Database → Connection string (Session or Transaction pooler).
# Username for the pooler is "fintrack_api.<project-ref>".
DATABASE_URL=postgresql://fintrack_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Supabase project URL. Access tokens are verified against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json (asymmetric signing keys).
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy shared HS256 JWT secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Expose /docs, /redoc and /openapi.json (defaults to off when ENVIRONMENT=production)
ENABLE_DOCS=true
